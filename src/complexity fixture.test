// Tests for the complexity fixture. Delete after testing.
import { test } from "node:test";
import assert from "node:assert/strict";
import {
  fixtureScore01,
  fixtureScore02,
  fixtureScore03,
  fixtureScore04,
  fixtureScore05,
  fixtureScore06,
  fixtureScore07,
  fixtureScore08,
  fixtureScore09,
  fixtureScore10,
  fixtureScore11,
  fixtureScore12,
  fixtureScore13,
  fixtureScore14,
  fixtureScore15,
  fixtureScore16,
  fixtureScore17,
  fixtureScore18,
  fixtureScore19,
  fixtureScore20,
} from "./complexity-fixture.ts";

test("fixtureScore01 returns finite numbers for every mode", () => {
  assert.ok(Number.isFinite(fixtureScore01(3, 7, "double", [true, false, true])));
  assert.ok(Number.isFinite(fixtureScore01(3, 7, "half", [true, false, true])));
  assert.ok(Number.isFinite(fixtureScore01(3, 7, "negate", [true, false, true])));
  assert.ok(Number.isFinite(fixtureScore01(3, 7, "strict", [true, false, true])));
  assert.ok(Number.isFinite(fixtureScore01(3, 7, "other", [true, false, true])));
  assert.ok(Number.isFinite(fixtureScore01(12, 15, "other", [])));
  assert.ok(Number.isFinite(fixtureScore01(-1, 4, "strict", [false, false])));
});

test("fixtureScore01 stays within bounds", () => {
  const result = fixtureScore01(500, 900, "double", [true, true, true, true]);
  assert.ok(result <= 1003);
  assert.ok(result >= -1000);
});

